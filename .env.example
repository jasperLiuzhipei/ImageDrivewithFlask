# Copy to .env and adjust values for local development

# Flask config selection: dev | prod | test
FLASK_CONFIG=dev

# Security
SECRET_KEY=change-this-to-a-random-long-string

# Database
# For SQLite leave empty; to use Postgres, set to the DSN below
DATABASE_URL=postgresql://webimg:webimg@localhost:5432/webimagedrive

# JWT (seconds)
JWT_ACCESS_TOKEN_EXPIRES=3600

# App metadata
APP_VERSION=0.1.0

# CORS
CORS_ORIGINS=*

# Storage (for MinIO/S3, to be used later)
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_BUCKET=images
# STORAGE_ACCESS_KEY=xxxx
# STORAGE_SECRET_KEY=yyyy

# Upload
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif

# Embedding backend
# 默认关闭队友 CLIP 后端，确保纯 pip 也能启动；若已安装 others/7008A_Clip-main 所需依赖，可开启
USE_TEAM_CLIP=0
# 如需指定队友处理器路径，设置为绝对路径或仓库内相对路径
# TEAM_CLIP_PROCESSOR_PATH=others/7008A_Clip-main/clip_pipeline/processor.py

# Vector index
INDEX_DIR=instance/faiss

# Admin - 默认管理员用户名（可根据需要调整）。
# 若未设置，本系统也会在未配置的情况下将用户名 'admin' 视作管理员。
# 推荐明确设置如下：
# ADMIN_USERS=admin
# 或按用户 ID：
# ADMIN_USER_IDS=1

# Base dataset upload
ENABLE_INITIALIZATION=True  # suggested: set to false after initialization is complete
BASE_DATASET_PATH=./data/tiny-imagenet-200/train
BASE_UPLOAD_BATCH_SIZE=32
LEN_SUBSET=1000